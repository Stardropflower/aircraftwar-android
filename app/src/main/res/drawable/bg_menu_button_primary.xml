<?xml version="1.0" encoding="utf-8"?>
<!--
    主按钮（「开始游戏」）：比次级按钮更亮、更厚，用青色描边 + 内发光暗示这是主要动作。
    其余按钮沿用 bg_menu_button（中性描边），形成主次层级。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4A3EC8FF">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#1D3A4E"
                android:endColor="#152430" />
            <stroke
                android:width="1dp"
                android:color="#553EC8FF" />
        </shape>
    </item>

</ripple>
