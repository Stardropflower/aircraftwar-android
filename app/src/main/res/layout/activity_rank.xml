<?xml version="1.0" encoding="utf-8"?>
<!--
    排行榜页面布局（实验四第 1 项：开发排行榜页面）。
    结构：顶部返回条 + 难度切换 + ListView 列表（空时显示提示）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_rank"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- 顶部：返回按钮 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="← 返回"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_hover"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="排行榜"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <!-- 占位，让标题视觉居中 -->
        <View
            android:layout_width="72dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <!-- 难度切换（三档难度分别展示，对应任务书「按三档难度分别展示」） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btn_tab_easy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="简单"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textColor="@color/success"
            android:backgroundTint="@color/surface_hover" />

        <Button
            android:id="@+id/btn_tab_normal"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="普通"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:backgroundTint="@color/surface_hover" />

        <Button
            android:id="@+id/btn_tab_hard"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="困难"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:backgroundTint="@color/surface_hover" />

    </LinearLayout>

    <!-- 表头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="56dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:text="排名"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="姓名"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:text="分数"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:gravity="end" />

    </LinearLayout>

    <!-- 列表 + 空状态提示叠在一起 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_rank"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="还没有记录\n去玩一局吧"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:gravity="center" />

</LinearLayout>
