<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AircraftWar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.GameActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.AircraftWar.Fullscreen" />

        <activity
            android:name=".ui.SkinActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/skin_title"
            android:parentActivityName=".ui.MainActivity" />

        <!-- 实验四：排行榜页面（ListView + SQLite） -->
        <activity
            android:name=".ui.RankActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/rank_title"
            android:parentActivityName=".ui.MainActivity" />

    </application>

</manifest>
